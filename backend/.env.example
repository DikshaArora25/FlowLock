# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String Placeholders (Never commit real credentials)
# Example Local: mongodb://127.0.0.1:27017/flowlock
# Example Atlas: mongodb+srv://<username>:<password>@<cluster-subdomain>.mongodb.net/flowlock?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-subdomain>.mongodb.net/flowlock?retryWrites=true&w=majority

# Frontend Origin for CORS configuration
FRONTEND_URL=http://localhost:3000

# Authentication & JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=24h
