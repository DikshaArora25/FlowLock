{
  "name": "flowlock-backend",
  "version": "1.0.0",
  "description": "Express MVC backend for FlowLock dependency-aware task management application",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "test:activity": "node --test tests/activity.test.js",
    "test:task": "node --test tests/task.test.js",
    "test:auth": "node --test tests/auth.test.js"
  },
  "keywords": [
    "flowlock",
    "express",
    "mongodb",
    "mongoose",
    "task-management",
    "dependency-graph"
  ],
  "author": "FlowLock Development Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5"
  }
}
